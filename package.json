{
  "name": "threadloop",
  "version": "0.1.0",
  "description": "Local-first CLI companion for review-ready AI-assisted coding artifacts",
  "type": "module",
  "bin": {
    "threadloop": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup src/cli.ts --format esm --dts --clean --out-dir dist --tsconfig tsconfig.build.json",
    "prepare": "npm run build && node .husky/install.mjs",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings=0",
    "lint:markdown": "markdownlint \"**/*.md\"",
    "typecheck": "tsc --noEmit",
    "dead-code": "knip",
    "check:community": "tsx scripts/check-community.ts",
    "check:static": "npm run format:check && npm run lint && npm run lint:markdown && npm run typecheck && npm run dead-code && npm run check:community",
    "check": "npm run check:static && npm test && npm run build && npm run smoke:pack",
    "security:dependencies": "npm audit --audit-level=high",
    "sensor:ci-gate:run": "tsx scripts/run-ci-gate-sensor.ts",
    "sensor:ci-gate:sign": "tsx scripts/sign-ci-gate-receipt.ts",
    "sensor:github-review:collect": "tsx scripts/collect-github-review-snapshot.ts",
    "sensor:github-review:sign": "tsx scripts/sign-github-review-receipt.ts",
    "prove:gaap:goose": "python3 scripts/prove-gaap-goose.py"
  },
  "keywords": [
    "cli",
    "git",
    "developer-tools",
    "productivity"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nnennandukwe/threadloop.git"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@sigstore/bundle": "5.0.0",
    "@sigstore/sign": "5.0.0",
    "ajv": "8.20.0",
    "commander": "^15.0.0",
    "prompts": "^2.4.2",
    "sigstore": "5.0.0",
    "threadloop-contracts": "git+https://github.com/nnennandukwe/threadloop-contracts.git#4ed9a94a2a089b9ae950d93297f7a6b9b939d3a6",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.9.7",
    "@types/prompts": "2.4.9",
    "eslint": "10.10.0",
    "eslint-plugin-security": "4.0.1",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "knip": "6.37.0",
    "lint-staged": "16.4.0",
    "markdownlint-cli": "0.49.1",
    "prettier": "3.9.8",
    "tsup": "9.0.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "markdownlint-cli": {
      "js-yaml": "5.5.0",
      "smol-toml": "1.9.1"
    },
    "micromark-extension-math": {
      "katex": "0.18.11"
    }
  }
}
