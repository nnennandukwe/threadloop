{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "project": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.{ts,mjs}"],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["mkfifo"],
  "vitest": {
    "entry": ["tests/**/*.test.ts"]
  },
  "entry": [
    "scripts/prove-gaap-goose.ts",
    "scripts/smoke-managed-workflow.ts",
    "tests/fixtures/gaap-native-producer.ts",
    "scripts/controller-generated/*.ts"
  ]
}
