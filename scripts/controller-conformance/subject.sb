(version 1)
(allow default)
(deny file-read* file-write* network* process-fork process-exec)
(import "dyld-support.sb")
(allow process-exec (literal (param "NODE")))
(allow file-read-data file-read-metadata file-map-executable
  (literal (param "NODE"))
  (literal (param "ARTIFACT"))
  (literal (param "REQUEST_SCHEMA"))
  (literal (param "RECEIPT_SCHEMA"))
  (subpath "/System/Library")
  (subpath "/usr/lib")
  (literal "/dev/null")
  (literal "/dev/random")
  (literal "/dev/urandom"))
(allow file-read-metadata (literal "/") (literal "/private") (literal "/private/tmp"))
(allow file-read* file-write* (subpath (param "SCRATCH")))
(allow file-read-metadata (path-ancestors (param "ARTIFACT")) (path-ancestors (param "SCRATCH")) (path-ancestors (param "NODE")))
