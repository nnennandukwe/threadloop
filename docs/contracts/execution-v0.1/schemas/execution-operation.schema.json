{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "id": {
      "$ref": "#/$defs/NonEmptyText"
    },
    "request": {
      "$ref": "#/$defs/RequestReference"
    },
    "binding": {
      "$ref": "#/$defs/RequestBinding"
    },
    "execution_policy": {
      "$ref": "#/$defs/Identity"
    },
    "actor": {
      "$ref": "#/$defs/Actor"
    },
    "expected_revision": {
      "$ref": "#/$defs/SafeCounter"
    },
    "expected_execution_digest": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "command": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "acquire"
            },
            "claim_id": {
              "$ref": "#/$defs/NonEmptyText"
            },
            "attempt_id": {
              "$ref": "#/$defs/NonEmptyText"
            },
            "executor": {
              "$ref": "#/$defs/Executor"
            },
            "valid_until": {
              "$ref": "#/$defs/AuthorityTime"
            }
          },
          "required": ["kind", "claim_id", "attempt_id", "executor", "valid_until"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "register_request"
            },
            "request": {
              "$ref": "#/$defs/ActionRequest"
            }
          },
          "required": ["kind", "request"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "replace"
            },
            "claim_id": {
              "$ref": "#/$defs/NonEmptyText"
            },
            "attempt_id": {
              "$ref": "#/$defs/NonEmptyText"
            },
            "executor": {
              "$ref": "#/$defs/Executor"
            },
            "valid_until": {
              "$ref": "#/$defs/AuthorityTime"
            },
            "previous_claim": {
              "$ref": "#/$defs/ClaimReference"
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/NonEmptyText"
              }
            }
          },
          "required": ["kind", "claim_id", "attempt_id", "executor", "valid_until", "previous_claim", "evidence_ids"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "start"
            },
            "claim": {
              "$ref": "#/$defs/ClaimReference"
            },
            "attempt_id": {
              "$ref": "#/$defs/NonEmptyText"
            }
          },
          "required": ["kind", "claim", "attempt_id"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "renew"
            },
            "claim": {
              "$ref": "#/$defs/ClaimReference"
            },
            "attempt_id": {
              "$ref": "#/$defs/NonEmptyText"
            },
            "valid_until": {
              "$ref": "#/$defs/AuthorityTime"
            }
          },
          "required": ["kind", "claim", "attempt_id", "valid_until"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "release"
            },
            "claim": {
              "$ref": "#/$defs/ClaimReference"
            },
            "attempt_id": {
              "$ref": "#/$defs/NonEmptyText"
            }
          },
          "required": ["kind", "claim", "attempt_id"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "expire"
            },
            "claim": {
              "$ref": "#/$defs/ClaimReference"
            },
            "attempt_id": {
              "$ref": "#/$defs/NonEmptyText"
            }
          },
          "required": ["kind", "claim", "attempt_id"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "cancel"
            },
            "reason": {
              "$ref": "#/$defs/NonEmptyText"
            }
          },
          "required": ["kind", "reason"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "invalidate"
            },
            "reason": {
              "type": "string",
              "enum": ["binding_changed", "authority_revoked", "integrity_failure", "request_expired"]
            }
          },
          "required": ["kind", "reason"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "submit_receipt"
            },
            "receipt": {
              "$ref": "#/$defs/AttemptReceipt"
            }
          },
          "required": ["kind", "receipt"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "reconcile"
            },
            "claim": {
              "$ref": "#/$defs/ClaimReference"
            },
            "attempt_id": {
              "$ref": "#/$defs/NonEmptyText"
            },
            "disposition": {
              "type": "string",
              "enum": ["effect_confirmed", "no_effect_confirmed", "abandon"]
            },
            "evidence_ids": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/NonEmptyText"
              }
            },
            "reason": {
              "$ref": "#/$defs/NonEmptyText"
            }
          },
          "required": ["kind", "claim", "attempt_id", "disposition", "evidence_ids", "reason"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "resolve_conflict"
            },
            "conflict_id": {
              "$ref": "#/$defs/Sha256Digest"
            },
            "original_digest": {
              "$ref": "#/$defs/Sha256Digest"
            },
            "reason": {
              "$ref": "#/$defs/NonEmptyText"
            }
          },
          "required": ["kind", "conflict_id", "original_digest", "reason"],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "request",
    "binding",
    "execution_policy",
    "actor",
    "expected_revision",
    "expected_execution_digest",
    "command"
  ],
  "additionalProperties": false,
  "$defs": {
    "NonEmptyText": {
      "type": "string",
      "minLength": 1
    },
    "RequestReference": {
      "type": "object",
      "properties": {
        "idempotency_key": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "request_digest": {
          "$ref": "#/$defs/Sha256Digest"
        }
      },
      "required": ["idempotency_key", "request_digest"],
      "additionalProperties": false
    },
    "Sha256Digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "RequestBinding": {
      "type": "object",
      "properties": {
        "workflow_run_id": {
          "type": "string",
          "minLength": 1
        },
        "graph_schema_version": {
          "type": "string",
          "const": "0.1"
        },
        "graph_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_state": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "state_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "subject": {
          "$ref": "#/$defs/Subject"
        }
      },
      "required": [
        "workflow_run_id",
        "graph_schema_version",
        "graph_digest",
        "source_state",
        "state_version",
        "subject"
      ],
      "additionalProperties": false
    },
    "Subject": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "repository"
            },
            "repository_id": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "content_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": ["kind", "repository_id", "revision", "content_digest"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "artifact"
            },
            "artifact_id": {
              "type": "string",
              "minLength": 1
            },
            "content_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": ["kind", "artifact_id", "content_digest"],
          "additionalProperties": false
        }
      ]
    },
    "Identity": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "digest": {
          "$ref": "#/$defs/Sha256Digest"
        }
      },
      "required": ["id", "digest"],
      "additionalProperties": false
    },
    "Actor": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "executor"
            },
            "executor": {
              "$ref": "#/$defs/Executor"
            }
          },
          "required": ["kind", "executor"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["threadloop", "human"]
            },
            "identity": {
              "$ref": "#/$defs/Identity"
            }
          },
          "required": ["kind", "identity"],
          "additionalProperties": false
        }
      ]
    },
    "Executor": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "incarnation": {
          "$ref": "#/$defs/NonEmptyText"
        }
      },
      "required": ["id", "incarnation"],
      "additionalProperties": false
    },
    "SafeCounter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "AuthorityTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "ActionRequest": {
      "type": "object",
      "properties": {
        "request": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "schema_version": {
                  "type": "string",
                  "const": "0.1"
                },
                "binding": {
                  "$ref": "#/$defs/RequestBinding"
                },
                "capability_catalog": {
                  "type": "string",
                  "const": "threadloop.sdlc/0.1"
                },
                "action_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                },
                "transition_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                },
                "guard_ids": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,63}$"
                  }
                },
                "inputs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "role": {
                        "type": "string",
                        "enum": [
                          "change_context",
                          "proof_plan",
                          "implementation_basis",
                          "release_manifest",
                          "publication_target"
                        ]
                      },
                      "artifact": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "digest": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          }
                        },
                        "required": ["id", "digest"],
                        "additionalProperties": false
                      }
                    },
                    "required": ["role", "artifact"],
                    "additionalProperties": false
                  }
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,63}$"
                  }
                },
                "constraints": {
                  "type": "object",
                  "properties": {
                    "require_current_subject": {
                      "type": "boolean",
                      "const": true
                    },
                    "lifecycle_mutation": {
                      "type": "boolean",
                      "const": false
                    },
                    "valid_until": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": ["require_current_subject", "lifecycle_mutation", "valid_until"],
                  "additionalProperties": false
                },
                "policy": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": ["id", "digest"],
                  "additionalProperties": false
                },
                "authorities": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": ["threadloop", "human"]
                      },
                      "identity": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "digest": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          }
                        },
                        "required": ["id", "digest"],
                        "additionalProperties": false
                      }
                    },
                    "required": ["type", "identity"],
                    "additionalProperties": false
                  }
                },
                "evidence_requirements": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "family": {
                        "anyOf": [
                          {
                            "type": "string",
                            "enum": [
                              "proof_plan",
                              "local_proof",
                              "independent_proof",
                              "pre_pr_review",
                              "review",
                              "human_approval",
                              "completion_observed",
                              "block_evidence",
                              "stop_requested",
                              "artifact"
                            ]
                          },
                          {
                            "type": "string",
                            "const": "repository_observation"
                          }
                        ]
                      },
                      "guard_id": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,63}$"
                      },
                      "subject": {
                        "$ref": "#/$defs/Subject"
                      }
                    },
                    "required": ["family", "guard_id", "subject"],
                    "additionalProperties": false
                  }
                },
                "idempotency_key": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "actor": {
                  "type": "string",
                  "const": "executor"
                },
                "capability": {
                  "type": "string",
                  "enum": [
                    "frame_change",
                    "bind_proof_plan",
                    "implement_change",
                    "commit_change",
                    "run_local_gates",
                    "obtain_independent_proof",
                    "record_pre_pr_review",
                    "obtain_review_evidence",
                    "repair_change",
                    "correct_gate_setup",
                    "restore_proof_authority",
                    "restore_repository",
                    "restore_evidence",
                    "prepare_release",
                    "verify_release",
                    "publish_release",
                    "verify_publication"
                  ]
                }
              },
              "required": [
                "schema_version",
                "binding",
                "capability_catalog",
                "action_id",
                "transition_id",
                "guard_ids",
                "inputs",
                "evidence_ids",
                "constraints",
                "policy",
                "authorities",
                "evidence_requirements",
                "idempotency_key",
                "actor",
                "capability"
              ],
              "additionalProperties": false
            },
