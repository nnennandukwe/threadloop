{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/NonEmptyText"
    },
    "digest": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "rules": {
      "type": "object",
      "properties": {
        "request": {
          "$ref": "#/$defs/RequestReference"
        },
        "workflow_policy": {
          "$ref": "#/$defs/Identity"
        },
        "retry_safety": {
          "type": "string",
          "enum": ["reconciliation_required", "repeatable_after_stop", "repeatable_with_overlap"]
        },
        "max_attempts": {
          "minimum": 1,
          "$ref": "#/$defs/SafeCounter"
        }
      },
      "required": ["request", "workflow_policy", "retry_safety", "max_attempts"],
      "additionalProperties": false
    }
  },
  "required": ["id", "digest", "rules"],
  "additionalProperties": false,
  "$defs": {
    "NonEmptyText": {
      "type": "string",
      "minLength": 1
    },
    "Sha256Digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "RequestReference": {
      "type": "object",
      "properties": {
        "idempotency_key": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "request_digest": {
          "$ref": "#/$defs/Sha256Digest"
        }
      },
      "required": ["idempotency_key", "request_digest"],
      "additionalProperties": false
    },
    "Identity": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "digest": {
          "$ref": "#/$defs/Sha256Digest"
        }
      },
      "required": ["id", "digest"],
      "additionalProperties": false
    },
    "SafeCounter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "$id": "https://github.com/nnennandukwe/threadloop/contracts/execution/0.1/execution-policy"
}
