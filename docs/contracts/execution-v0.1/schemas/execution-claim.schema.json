{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "id": {
      "$ref": "#/$defs/NonEmptyText"
    },
    "version": {
      "minimum": 1,
      "$ref": "#/$defs/SafeCounter"
    },
    "request": {
      "$ref": "#/$defs/RequestReference"
    },
    "binding": {
      "$ref": "#/$defs/RequestBinding"
    },
    "execution_policy": {
      "$ref": "#/$defs/Identity"
    },
    "executor": {
      "$ref": "#/$defs/Executor"
    },
    "attempt_id": {
      "$ref": "#/$defs/NonEmptyText"
    },
    "status": {
      "type": "string",
      "enum": ["active", "released", "expired", "replaced", "invalidated", "cancelled", "completed"]
    },
    "acquired_at": {
      "$ref": "#/$defs/AuthorityTime"
    },
    "renewed_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthorityTime"
        },
        {
          "type": "null"
        }
      ]
    },
    "valid_until": {
      "$ref": "#/$defs/AuthorityTime"
    },
    "closed_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthorityTime"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "request",
    "binding",
    "execution_policy",
    "executor",
    "attempt_id",
    "status",
    "acquired_at",
    "renewed_at",
    "valid_until",
    "closed_at"
  ],
  "additionalProperties": false,
  "$defs": {
    "NonEmptyText": {
      "type": "string",
      "minLength": 1
    },
    "SafeCounter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "RequestReference": {
      "type": "object",
      "properties": {
        "idempotency_key": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "request_digest": {
          "$ref": "#/$defs/Sha256Digest"
        }
      },
      "required": ["idempotency_key", "request_digest"],
      "additionalProperties": false
    },
    "Sha256Digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "RequestBinding": {
      "type": "object",
      "properties": {
        "workflow_run_id": {
          "type": "string",
          "minLength": 1
        },
        "graph_schema_version": {
          "type": "string",
          "const": "0.1"
        },
        "graph_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_state": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "state_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "subject": {
          "$ref": "#/$defs/Subject"
        }
      },
      "required": [
        "workflow_run_id",
        "graph_schema_version",
        "graph_digest",
        "source_state",
        "state_version",
        "subject"
      ],
      "additionalProperties": false
    },
    "Subject": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "repository"
            },
            "repository_id": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "content_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": ["kind", "repository_id", "revision", "content_digest"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "artifact"
            },
            "artifact_id": {
              "type": "string",
              "minLength": 1
            },
            "content_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": ["kind", "artifact_id", "content_digest"],
          "additionalProperties": false
        }
      ]
    },
    "Identity": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "digest": {
          "$ref": "#/$defs/Sha256Digest"
        }
      },
      "required": ["id", "digest"],
      "additionalProperties": false
    },
    "Executor": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "incarnation": {
          "$ref": "#/$defs/NonEmptyText"
        }
      },
      "required": ["id", "incarnation"],
      "additionalProperties": false
    },
    "AuthorityTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    }
  },
  "$id": "https://github.com/nnennandukwe/threadloop/contracts/execution/0.1/execution-claim"
}
