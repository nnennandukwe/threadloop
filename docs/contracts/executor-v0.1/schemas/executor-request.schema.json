{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "threadloop.executor/0.1"
        },
        "kind": {
          "type": "string",
          "const": "execute"
        },
        "action_request": {
          "type": "object",
          "properties": {
            "request": {
              "type": "object",
              "properties": {
                "schema_version": {
                  "type": "string",
                  "const": "0.1"
                },
                "binding": {
                  "type": "object",
                  "properties": {
                    "workflow_run_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "graph_schema_version": {
                      "type": "string",
                      "const": "0.1"
                    },
                    "graph_digest": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "source_state": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,63}$"
                    },
                    "state_version": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "subject": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "repository"
                            },
                            "repository_id": {
                              "type": "string",
                              "minLength": 1
                            },
                            "revision": {
                              "type": "string",
                              "minLength": 1
                            },
                            "content_digest": {
                              "type": "string",
                              "pattern": "^[a-f0-9]{64}$"
                            }
                          },
                          "required": ["kind", "repository_id", "revision", "content_digest"],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "artifact"
                            },
                            "artifact_id": {
                              "type": "string",
                              "minLength": 1
                            },
                            "content_digest": {
                              "type": "string",
                              "pattern": "^[a-f0-9]{64}$"
                            }
                          },
                          "required": ["kind", "artifact_id", "content_digest"],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "required": [
                    "workflow_run_id",
                    "graph_schema_version",
                    "graph_digest",
                    "source_state",
                    "state_version",
                    "subject"
                  ],
                  "additionalProperties": false
                },
                "capability_catalog": {
                  "type": "string",
                  "const": "threadloop.sdlc/0.1"
                },
                "action_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                },
                "transition_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                },
                "guard_ids": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,63}$"
                  }
                },
                "inputs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "role": {
                        "type": "string",
                        "enum": [
                          "change_context",
                          "proof_plan",
                          "implementation_basis",
                          "release_manifest",
                          "publication_target"
                        ]
                      },
                      "artifact": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "digest": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          }
                        },
                        "required": ["id", "digest"],
                        "additionalProperties": false
                      }
                    },
                    "required": ["role", "artifact"],
                    "additionalProperties": false
                  }
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,63}$"
                  }
                },
                "constraints": {
                  "type": "object",
                  "properties": {
                    "require_current_subject": {
                      "type": "boolean",
                      "const": true
                    },
                    "lifecycle_mutation": {
                      "type": "boolean",
                      "const": false
                    },
                    "valid_until": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": ["require_current_subject", "lifecycle_mutation", "valid_until"],
                  "additionalProperties": false
                },
                "policy": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": ["id", "digest"],
                  "additionalProperties": false
                },
                "authorities": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": ["threadloop", "human"]
                      },
                      "identity": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "digest": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          }
                        },
                        "required": ["id", "digest"],
                        "additionalProperties": false
                      }
                    },
                    "required": ["type", "identity"],
                    "additionalProperties": false
                  }
                },
                "evidence_requirements": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "family": {
                        "anyOf": [
                          {
                            "type": "string",
                            "enum": [
                              "proof_plan",
                              "local_proof",
                              "independent_proof",
                              "pre_pr_review",
                              "review",
                              "human_approval",
                              "completion_observed",
                              "block_evidence",
                              "stop_requested",
                              "artifact"
                            ]
                          },
                          {
                            "type": "string",
                            "const": "repository_observation"
                          }
                        ]
                      },
                      "guard_id": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,63}$"
                      },
                      "subject": {
                        "oneOf": [
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "repository"
                              },
                              "repository_id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "revision": {
                                "type": "string",
                                "minLength": 1
                              },
                              "content_digest": {
                                "type": "string",
                                "pattern": "^[a-f0-9]{64}$"
                              }
                            },
                            "required": ["kind", "repository_id", "revision", "content_digest"],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "artifact"
                              },
                              "artifact_id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "content_digest": {
                                "type": "string",
                                "pattern": "^[a-f0-9]{64}$"
                              }
                            },
                            "required": ["kind", "artifact_id", "content_digest"],
                            "additionalProperties": false
                          }
                        ]
                      }
                    },
                    "required": ["family", "guard_id", "subject"],
                    "additionalProperties": false
                  }
                },
                "idempotency_key": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "actor": {
                  "type": "string",
                  "const": "executor"
                },
                "capability": {
                  "type": "string",
                  "enum": [
                    "frame_change",
                    "bind_proof_plan",
                    "implement_change",
                    "commit_change",
                    "run_local_gates",
                    "obtain_independent_proof",
                    "record_pre_pr_review",
                    "obtain_review_evidence",
                    "repair_change",
                    "correct_gate_setup",
                    "restore_proof_authority",
                    "restore_repository",
                    "restore_evidence",
                    "prepare_release",
                    "verify_release",
                    "publish_release",
                    "verify_publication"
                  ]
                }
              },
              "required": [
                "schema_version",
                "binding",
                "capability_catalog",
                "action_id",
                "transition_id",
                "guard_ids",
                "inputs",
                "evidence_ids",
                "constraints",
                "policy",
                "authorities",
                "evidence_requirements",
                "idempotency_key",
                "actor",
                "capability"
              ],
              "additionalProperties": false
            },
            "request_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": ["request", "request_digest"],
          "additionalProperties": false
        },
        "execution_policy": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": ["id", "digest"],
          "additionalProperties": false
        },
        "claim": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": ["id", "version"],
          "additionalProperties": false
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "executor": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "incarnation": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["id", "incarnation"],
          "additionalProperties": false
        },
        "mapping_policy": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": ["id", "digest"],
          "additionalProperties": false
        },
        "parameters": {
          "type": "object",
          "properties": {
            "subject_locator": {
              "type": "string",
              "minLength": 1
            },
            "capability": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": ["name", "version", "digest"],
              "additionalProperties": false
            },
            "task": {
              "type": "object",
              "properties": {
                "instructions": {
                  "type": "string",
                  "minLength": 1
                },
                "constraints": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": ["instructions", "constraints"],
              "additionalProperties": false
            },
            "policies": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": ["name", "version", "digest"],
                "additionalProperties": false
              },
              "uniqueItems": true
            },
            "resource_budget": {
              "type": "object",
              "properties": {
                "max_cost_micros": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "max_elapsed_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "max_model_tokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "max_tool_calls": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["max_cost_micros", "max_elapsed_ms", "max_model_tokens", "max_tool_calls"],
              "additionalProperties": false
            },
            "approval_context": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "approval_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "actor_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scope": {
                    "type": "string",
                    "minLength": 1
                  },
                  "subject_digest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "evidence": {
                    "type": "object",
                    "properties": {
                      "evidence_type": {
                        "type": "string",
                        "enum": [
                          "approval",
                          "command_output",
                          "artifact",
                          "tool_execution",
                          "verification_attestation",
                          "resource_usage",
                          "interruption"
                        ]
                      },
                      "digest": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "locator": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": ["evidence_type", "digest", "locator"],
                    "additionalProperties": false
                  }
                },
                "required": ["approval_id", "actor_id", "scope", "subject_digest", "evidence"],
                "additionalProperties": false
              }
            },
            "required_verification": {
              "type": "object",
              "properties": {
                "independence": {
                  "type": "string",
                  "const": "different_actor"
                },
                "evidence_types": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "approval",
                      "command_output",
                      "artifact",
                      "tool_execution",
                      "verification_attestation",
                      "resource_usage",
                      "interruption"
                    ]
                  },
                  "uniqueItems": true
                }
              },
              "required": ["independence", "evidence_types"],
              "additionalProperties": false
            }
          },
          "required": [
            "subject_locator",
            "capability",
            "task",
            "policies",
            "resource_budget",
            "approval_context",
            "required_verification"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "kind",
        "action_request",
        "execution_policy",
        "claim",
        "attempt_id",
        "executor",
        "mapping_policy",
        "parameters"
      ],
      "additionalProperties": false
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": ["request", "request_digest"],
  "additionalProperties": false,
  "$id": "https://github.com/nnennandukwe/threadloop/contracts/executor/0.1/executor-request"
}
