{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "initial": {
      "type": "object",
      "properties": {
        "context": {
          "$ref": "#/$defs/__schema0"
        },
        "request": {
          "$ref": "#/$defs/__schema0"
        },
        "policy": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": ["context", "request", "policy"],
      "additionalProperties": false
    },
    "steps": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "admitted_digests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "projection_snapshot": {
      "$ref": "#/$defs/__schema0"
    }
  },
  "required": ["initial", "steps", "admitted_digests", "projection_snapshot"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "context": {
          "$ref": "#/$defs/__schema0"
        },
        "operation": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": ["context", "operation"],
      "additionalProperties": false
    }
  },
  "$id": "https://github.com/nnennandukwe/threadloop/contracts/controller-conformance/0.1/execution-scenario"
}
