{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "string",
          "const": "threadloop.controller-conformance/0.1"
        },
        "fixture_schema": {
          "type": "string",
          "const": "threadloop.conformance-fixture/0.1"
        },
        "canonicalization": {
          "type": "string",
          "const": "threadloop.conformance-json/0.1"
        },
        "digest_profile": {
          "type": "string",
          "const": "threadloop.conformance-sha256/0.1"
        },
        "schema": {
          "type": "string",
          "const": "threadloop.conformance-request/0.1"
        },
        "corpus_digest": {
          "$ref": "#/$defs/__schema0"
        },
        "case_id": {
          "type": "string",
          "pattern": "^case_[0-9]{3}$"
        },
        "operation": {
          "type": "string",
          "enum": ["compile_graph", "decide", "execution_scenario"]
        },
        "input": {
          "$ref": "#/$defs/__schema1"
        },
        "input_digest": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "protocol",
        "fixture_schema",
        "canonicalization",
        "digest_profile",
        "schema",
        "corpus_digest",
        "case_id",
        "operation",
        "input",
        "input_digest"
      ],
      "additionalProperties": false
    },
    "request_digest": {
      "$ref": "#/$defs/__schema0"
    }
  },
  "required": ["request", "request_digest"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "__schema1": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema1"
          }
        }
      ]
    }
  },
  "$id": "https://github.com/nnennandukwe/threadloop/contracts/controller-conformance/0.1/request"
}
